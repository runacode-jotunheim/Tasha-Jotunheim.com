# Скопируйте этот файл в .env на сервере Timeweb Cloud и заполните реальными значениями.
# Файл .env НИКОГДА не коммитится в git (см. .gitignore) — секреты живут только на сервере.

# --- Робокасса ---
# MerchantLogin из ЛК Робокассы (не секрет, но проще держать в конфиге)
ROBOKASSA_LOGIN=

# Пароль #1 — для подписи исходящего запроса на оплату. Технические настройки ЛК Робокассы.
ROBOKASSA_PASSWORD_1=

# Пароль #2 — для проверки входящего уведомления об оплате (ResultURL). Технические настройки ЛК Робокассы.
ROBOKASSA_PASSWORD_2=

# 1 = тестовый режим (пока магазин "в процессе активации"), 0 = боевой режим
ROBOKASSA_TEST_MODE=1

# Код системы налогообложения для чека 54-ФЗ. У ИП Йотунхейм — УСН доходы (osn/usn_income/usn_income_outcome/esn/patent)
ROBOKASSA_TAX_SYSTEM=usn_income

# --- Сервер ---
PORT=3000

# Домен фронтенда, которому разрешено обращаться к API (CORS)
ALLOWED_ORIGIN=https://tasha-jotunheim.com

# --- Уведомления о заказах (опционально, но рекомендуется, пока нет своей БД заказов) ---
# Токен телеграм-бота (создаётся через @BotFather) и chat_id, куда слать уведомления о новых оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Скопируйте этот файл в .env на сервере Timeweb Cloud и заполните реальными значениями.
# Файл .env НИКОГДА не коммитится в git (см. .gitignore) — секреты живут только на сервере.

# --- Робокасса ---
# MerchantLogin из ЛК Робокассы (не секрет, но проще держать в конфиге)
ROBOKASSA_LOGIN=

# Пароль #1 — для подписи исходящего запроса на оплату. Технические настройки ЛК Робокассы.
ROBOKASSA_PASSWORD_1=

# Пароль #2 — для проверки входящего уведомления об оплате (ResultURL). Технические настройки ЛК Робокассы.
ROBOKASSA_PASSWORD_2=

# ⚠ ОБЯЗАТЕЛЬНО при ROBOKASSA_TEST_MODE=1 — Робокасса требует ОТДЕЛЬНУЮ пару паролей
# для тестовых платежей (IsTest=1). Использование боевых паролей вместе с IsTest=1
# даёт ошибку 29 "Оплата счетов недоступна". Смотреть в ЛК Робокассы → карточка
# магазина → Технические настройки → там же, где боевые пароли, обычно отдельным блоком.
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=

# 1 = тестовый режим (пока магазин "в процессе активации"), 0 = боевой режим
ROBOKASSA_TEST_MODE=1

# Код системы налогообложения для чека 54-ФЗ. У ИП Йотунхейм — УСН доходы (osn/usn_income/usn_income_outcome/esn/patent)
ROBOKASSA_TAX_SYSTEM=usn_income

# --- Сервер ---
PORT=3000

# Домен фронтенда, которому разрешено обращаться к API (CORS)
ALLOWED_ORIGIN=https://tasha-jotunheim.com

# --- Уведомления о заказах (опционально, но рекомендуется, пока нет своей БД заказов) ---
# Токен телеграм-бота (создаётся через @BotFather) и chat_id, куда слать уведомления о новых оплаченных заказах
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ================================================================
# --- Программа лояльности (включается, только если задан DATABASE_URL) ---
# Пока DATABASE_URL пустой — сервер работает как раньше: только оплата и уведомления.
# ================================================================

# PostgreSQL из панели Timeweb Cloud → Базы данных (строка подключения).
DATABASE_URL=
# 1 — если база требует SSL (у Timeweb Cloud Databases обычно да)
DATABASE_SSL=1

# Адрес сайта (для реф-ссылок) и домен для cookie кабинета (с точкой в начале)
SITE_URL=https://tasha-jotunheim.com
COOKIE_DOMAIN=.tasha-jotunheim.com

# Почта для кодов входа: ящик Mail.ru + «пароль для внешнего приложения»
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Артефакты Йотунхейм

# Telegram: тот же бот. Имя бота без @ (для ссылки привязки) и вебхук для приёма /start
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=https://api.tasha-jotunheim.com/api/tg/webhook
# Любая длинная случайная строка (латиница/цифры), придумайте сами
TELEGRAM_WEBHOOK_SECRET=

# 1 — отклонять товары, которых нет в серверном каталоге (catalog.json). Включить после обновления корзины на сайте.
STRICT_PRICES=0
